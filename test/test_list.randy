#include std/core
#include std/list

def main in
    var list = List::new();

    var i = 0;
    printf("Append to list\n");
    while i < 10 do
        list.append(cast(i, ptr));
        i += 1;
    end

    printf("Enumerate the list\n");
    var cur = list.head;
    while cur do
        printf("%d\n", cur.data);
        cur = cur.next;
    end

    list.delete();
    return 0;
end
