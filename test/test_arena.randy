#include std/core
#include std/arena

def test msg, cond in
    if cond then
        printf("pass: %s\n", msg);
    else
        printf("fail: %s\n", msg);
    end
end

def main in
    // Test basic arena creation
    var arena = Arena::new(10, 8);
    test("arena length is 10", 10 == arena.length);
    test("arena elem_size is 8", 8 == arena.elem_size);

    // Test set and read back via pointer
    var i = 0;
    while i < 10 do
        var val = (i + 1) * 100;
        u64!(arena.at(i), val);
        i += 1;
    end

    i = 0;
    while i < 10 do
        var val = u64@(arena.at(i));
        test("arena read back correct", (i + 1) * 100 == val);
        i += 1;
    end

    // Test arena set with memcpy semantics
    var src = malloc(8);
    u64!(src, 99999);
    arena.set(5, src);
    test("arena set writes correctly", 99999 == u64@(arena.at(5)));
    free(src);

    // Test overwrite
    u64!(arena.at(0), 42);
    test("arena overwrite works", 42 == u64@(arena.at(0)));

    // Other slots unchanged
    test("arena slot 1 unchanged", 200 == u64@(arena.at(1)));

    arena.delete();

    // Test arena with elem_size 1 (byte arena)
    var byte_arena = Arena::new(256, 1);
    test("byte arena length is 256", 256 == byte_arena.length);
    test("byte arena elem_size is 1", 1 == byte_arena.elem_size);

    i = 0;
    while i < 256 do
        u8!(byte_arena.at(i), i);
        i += 1;
    end

    i = 0;
    while i < 256 do
        var b = cast(u8@(byte_arena.at(i)), int);
        test("byte arena read back", i == b);
        i += 1;
    end

    byte_arena.delete();

    printf("arena tests done.\n");
    return 0;
end
