#include std/core

def test msg, cond in
    if cond then
        printf("pass: %s\n", msg);
    else
        printf("fail: %s\n", msg);
    end
end

def main in
    // Basic arithmetic
    test("2 + 3 = 5", 5 == 2 + 3);
    test("10 - 7 = 3", 3 == 10 - 7);
    test("6 * 7 = 42", 42 == 6 * 7);
    test("100 / 10 = 10", 10 == 100 / 10);
    test("17 % 5 = 2", 2 == 17 % 5);

    // Negative arithmetic
    test("-1 + 1 = 0", 0 == -1 + 1);
    test("-5 * -3 = 15", 15 == -5 * -3);
    test("-10 / 2 = -5", -5 == -10 / 2);
    test("10 / -2 = -5", -5 == 10 / -2);

    // Negative modulo
    test("-7 % 3", -1 == -7 % 3);
    test("7 % -3", 1 == 7 % -3);

    // Operator precedence
    test("2 + 3 * 4 = 14", 14 == 2 + 3 * 4);
    test("(2 + 3) * 4 = 20", 20 == (2 + 3) * 4);
    test("10 - 2 * 3 = 4", 4 == 10 - 2 * 3);
    test("10 / 2 + 3 = 8", 8 == 10 / 2 + 3);

    // Comparison operators
    test("5 < 10", 5 < 10);
    test("not 10 < 5", not (10 < 5));
    test("5 <= 5", 5 <= 5);
    test("5 <= 10", 5 <= 10);
    test("10 > 5", 10 > 5);
    test("5 >= 5", 5 >= 5);
    test("5 == 5", 5 == 5);
    test("5 != 6", 5 != 6);

    // Large numbers
    var big = 1000000000;
    test("billion * 2", 2000000000 == big * 2);
    test("billion + billion", 2000000000 == big + big);

    // Chain of operations
    var x = 1;
    x += 2;
    x *= 3;
    x -= 1;
    test("chain: ((1+2)*3)-1 = 8", 8 == x);

    // Zero edge cases
    test("0 * big = 0", 0 == 0 * big);
    test("0 + 0 = 0", 0 == 0 + 0);
    test("big - big = 0", 0 == big - big);

    printf("arithmetic tests done.\n");
    return 0;
end
