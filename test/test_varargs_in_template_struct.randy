#include std/core
#include std/vector

struct List[T] in
    def new ...args: T in
        var vec = Vector[T]::new(args.length);
        for i in 0..args.length do
            vec.push(args.get(i));
        end
        return vec;
    end
end

def main in
    var list = List[int]::new(1, 2, 3, 4, 5);
    for i in 0..list.length do
        printf("list.get(%d) = %d\n", i, list.get(i));
    end
    list.delete();
    return 0;
end
