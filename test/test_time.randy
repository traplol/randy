#include std/core
#include std/time

def test msg, cond in
    if cond then
        printf("pass: %s\n", msg);
    else
        printf("fail: %s\n", msg);
    end
end

def main in
    // Test timespec creation
    var ts = Timespec::new(10, 500);
    test("timespec sec is 10", 10 == ts.tv_sec);
    test("timespec nsec is 500", 500 == ts.tv_nsec);
    Timespec::delete(ts);

    // Test make_empty_timespec
    var empty = Timespec::new(0, 0);
    test("empty timespec sec is 0", 0 == empty.tv_sec);
    test("empty timespec nsec is 0", 0 == empty.tv_nsec);
    Timespec::delete(empty);

    // Test monotonic clock reads
    var t1 = Timespec::new(0, 0);
    var t2 = Timespec::new(0, 0);
    time(t1);
    test("monotonic time sec >= 0", t1.tv_sec >= 0);
    test("monotonic time nsec >= 0", t1.tv_nsec >= 0);
    test("monotonic time nsec < 1 billion", t1.tv_nsec < CLOCK_NS_BOUNDS);

    // Second read should be >= first
    time(t2);
    test("monotonic time advances", t2.tv_sec >= t1.tv_sec);

    Timespec::delete(t1);
    Timespec::delete(t2);

    // Test realtime clock
    var rt = Timespec::new(0, 0);
    clock(rt);
    test("realtime sec > 0", rt.tv_sec > 0);
    test("realtime nsec >= 0", rt.tv_nsec >= 0);
    test("realtime nsec < 1 billion", rt.tv_nsec < CLOCK_NS_BOUNDS);
    Timespec::delete(rt);

    // Test usleep with timing
    var before = Timespec::new(0, 0);
    var after = Timespec::new(0, 0);
    time(before);
    usleep(10000); // 10ms
    time(after);

    // Should have advanced by at least some time
    var elapsed_sec = after.tv_sec - before.tv_sec;
    var elapsed_ns = after.tv_nsec - before.tv_nsec;
    if elapsed_ns < 0 then
        elapsed_sec -= 1;
        elapsed_ns += CLOCK_NS_BOUNDS;
    end
    var elapsed_us = elapsed_sec * CLOCK_S_PER_US + elapsed_ns / CLOCK_US_PER_NS;
    test("usleep(10000) slept at least 5000us", elapsed_us >= 5000);
    test("usleep(10000) slept less than 1s", elapsed_us < 1000000);

    Timespec::delete(before);
    Timespec::delete(after);

    printf("time tests done.\n");
    return 0;
end
