#include std/core

def main in
    var arr: int[3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;

    // Use a manual while loop to avoid for-loop variable issues
    var i = 0;
    while i < arr.length do
        printf("arr[%d] = %d\n", i, arr[i]);
        i += 1;
    end

    printf("pass\n");
    return 0;
end
