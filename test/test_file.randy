#include std/core

def test msg, cond in
    if cond then
        printf("pass: %s\n", msg);
    else
        printf("fail: %s\n", msg);
    end
end

def main in
    // Test file_exists
    test("test file exists", file_exists("test/test_file.randy"));
    test("nonexistent file does not exist", not file_exists("test/this_does_not_exist_12345"));

    // Test file_is_readable
    test("test file is readable", file_is_readable("test/test_file.randy"));
    test("nonexistent file is not readable", not file_is_readable("test/this_does_not_exist_12345"));

    // Test write, then read back
    var path = "out/test_file_tmp.txt";
    var wfd = open_for_write(path);
    defer close(wfd);
    test("open_for_write returns valid fd", cast(wfd, int) >= 0);

    var msg = "hello from randy";
    var wrote = write_file(wfd, msg, cstr_len(msg));
    test("write_file returns correct count", cstr_len(msg) == wrote);
    close(wfd);

    test("written file exists", file_exists(path));
    test("written file is readable", file_is_readable(path));

    // Read it back
    var rfd = open_for_read(path);
    defer close(rfd);
    test("open_for_read returns valid fd", cast(rfd, int) >= 0);

    var buf = malloc(1024);
    defer free(buf);
    memset(buf, 0, 1024);
    var nread = read_file(rfd, buf, 1023);
    test("read_file returns correct count", cstr_len(msg) == nread);
    test("read back matches written data", cstr_eq(cast(buf, cstr), msg));

    // Test getcwd
    var cwd = getcwd();
    defer cwd.delete();
    test("getcwd returns non-empty string", cwd.length > 0);

    // Clean up temp file
    syscall(SYS_unlink, path);

    printf("file tests done.\n");
    return 0;
end
