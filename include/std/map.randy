
#include memory

struct MapPair in
    key: ptr;
    val: ptr;
end

const MAP_Load_Factor = 2;
const MAP_Default_Cap = 16;

def _default_map_compare a: ptr, b: ptr -> bool in
    return a == b;
end

def _default_map_hash e: ptr -> int in
    return cast(e, int);
end

struct Map in
    length: int;
    capacity: int;
    buffer: ptr;
    comparer: ptr;
    hasher: ptr;
    cache: MapPair&;

    def new capacity: int, comparer: ptr, hasher: ptr in
        var self = cast(malloc(__sizeof(Map)), Map&);
        if capacity <= 0 then
            capacity = MAP_Default_Cap;
        end
        self.length = 0;
        self.capacity = capacity;
        self.buffer = calloc(capacity, __sizeof(MapPair));
        if not comparer then
            comparer = _default_map_compare;
        end
        if not hasher then
            hasher = _default_map_hash;
        end
        self.comparer = comparer;
        self.hasher = hasher;
        self.cache = NULL;
        return self;
    end

    def delete self in
        if self then
            free(self.buffer);
            free(self);
        end
    end

    def _at self, idx: int -> MapPair& in
        return cast(self.buffer + idx * __sizeof(MapPair), MapPair&);
    end

    def find self, key: ptr -> MapPair& in
        var comparer = cast(self.comparer, (ptr, ptr -> bool));
        if self.cache and comparer(self.cache.key, key) then
            return self.cache;
        end
        var cap = self.capacity;
        var hasher = cast(self.hasher, (ptr -> int));
        var idx = hasher(key) % cap;
        if idx < 0 then idx = 0 - idx; end
        var cur = self._at(idx);
        while cur.key do
            if comparer(cur.key, key) then
                self.cache = cur;
                return cur;
            end
            idx = (idx + 1) % cap;
            cur = self._at(idx);
        end
        return NULL;
    end

    def set self, key: ptr, value: ptr in
        var comparer = cast(self.comparer, (ptr, ptr -> bool));
        if self.cache and comparer(self.cache.key, key) then
            self.cache.val = value;
            return;
        end
        var cap = self.capacity;
        if self.length >= cap / MAP_Load_Factor then
            self._expand();
            cap = self.capacity;
        end

        var hasher = cast(self.hasher, (ptr -> int));
        var idx = hasher(key) % cap;
        if idx < 0 then idx = 0 - idx; end
        var cur = self._at(idx);
        while cur and cur.key do
            if comparer(cur.key, key) then
                cur = NULL;
            else
                idx = (idx + 1) % cap;
                cur = self._at(idx);
            end
        end
        cur = self._at(idx);
        if not cur.key then
            self.length = self.length + 1;
        end
        cur.key = key;
        cur.val = value;
        self.cache = cur;
    end

    def _expand self in
        self.cache = NULL;
        var old_cap = self.capacity;
        var old_buf = self.buffer;
        var new_cap = old_cap * 2;
        self.length = 0;
        self.capacity = new_cap;
        self.buffer = calloc(new_cap, __sizeof(MapPair));
        var i = 0;
        while i < old_cap do
            var elt = cast(old_buf + i * __sizeof(MapPair), MapPair&);
            if elt.key then
                self.set(elt.key, elt.val);
            end
            i += 1;
        end
        free(old_buf);
    end

    def remove self, elem: ptr in
        var cap = self.capacity;
        var hasher = cast(self.hasher, (ptr -> int));
        var idx = hasher(elem) % cap;
        if idx < 0 then idx = 0 - idx; end
        var comparer = cast(self.comparer, (ptr, ptr -> bool));
        var cur = self._at(idx);
        while cur and cur.key do
            if comparer(cur.key, elem) then
                cur = NULL;
            else
                idx = (idx + 1) % cap;
                cur = self._at(idx);
            end
        end
        cur = self._at(idx);
        if cur.key then
            self.length = self.length - 1;
        end
        cur.key = NULL;
    end

    def iter_end self -> MapPair& in
        return self._at(self.capacity);
    end

    def iter_begin self -> MapPair& in
        var cur = self._at(0);
        var e = self.iter_end();
        if self.length == 0 then
            return e;
        end
        while cur != e do
            if cur.key then
                return cur;
            end
            cur = cast(cast(cur, ptr) + __sizeof(MapPair), MapPair&);
        end
        return e;
    end

    def iter_next self, iter: MapPair& -> MapPair& in
        iter = cast(cast(iter, ptr) + __sizeof(MapPair), MapPair&);
        var e = self.iter_end();
        while iter != e do
            if iter.key then
                return iter;
            end
            iter = cast(cast(iter, ptr) + __sizeof(MapPair), MapPair&);
        end
        return e;
    end
end
