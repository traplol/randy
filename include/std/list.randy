
#include core
#include memory

struct ListNode in
    next: ListNode&;
    data: ptr;
end

struct List in
    head: ListNode&;
    tail: ListNode&;

    def new in
        var self = cast(malloc(__sizeof(List)), List&);
        self.head = NULL;
        self.tail = NULL;
        return self;
    end

    def delete self in
        var cur = self.head;
        while cur do
            var next = cur.next;
            free(cur);
            cur = next;
        end
        free(self);
    end

    def append self, data: ptr in
        var node = cast(malloc(__sizeof(ListNode)), ListNode&);
        node.next = NULL;
        node.data = data;

        if self.tail then
            self.tail.next = node;
        else
            self.head = node;
        end
        self.tail = node;
    end
end
