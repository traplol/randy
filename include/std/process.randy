#include core
#include memory
#include syscall

def execve path: cstr, argv: ptr, envp: ptr -> int in
    return cast(syscall(SYS_execve, path, argv, envp), int);
end

def fork in
    return cast(syscall(SYS_fork), int);
end

const P_PID = 1;
def waitpid pid: int, siginfo: ptr, options: int in
    return cast(syscall(SYS_waitid, P_PID, pid, siginfo, options), int);
end

// siginfo_t is 128 bytes with overlapping fields (union layout),
// so we use raw buffer access rather than a struct.
struct Siginfo in
    _buf: ptr;

    def new in
        var self = cast(malloc(__sizeof(Siginfo)), Siginfo&);
        self._buf = calloc(1, 128);
        return self;
    end

    def delete self in
        if self then
            free(self._buf);
            free(self);
        end
    end

    def si_signo self -> int in return cast(u32@(self._buf + 0), int); end
    def si_errno self -> int in return cast(u32@(self._buf + 4), int); end
    def si_code self -> int in return cast(u32@(self._buf + 8), int); end
    def si_pid self -> int in return cast(u32@(self._buf + 16), int); end
    def si_uid self -> int in return cast(u32@(self._buf + 20), int); end
    def si_status self -> int in return cast(u32@(self._buf + 24), int); end
    def si_value self -> int in return cast(u64@(self._buf + 24), int); end
    def si_addr self -> int in return cast(u64@(self._buf + 16), int); end
    def si_band self -> int in return cast(u64@(self._buf + 16), int); end
end

def subprocess_blocking path: cstr, argv: ptr, envp: ptr in
    var pid = fork();
    if pid == 0 then // child
        return execve(path, argv, envp);
    else
        var si = Siginfo::new();
        waitpid(pid, si._buf, 4);
        si.delete();
    end
    return 0;
end
