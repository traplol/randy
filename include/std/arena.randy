
#include core
#include memory

// The Arena data structure is a fixed-size, contiguous buffer with index-based
// access. It returns pointers to element slots since we cannot dereference
// memory of arbitrary size — but since passing by value is limited to 8 bytes,
// pointer access to slots suffices for most practical purposes.

struct Arena in
    length: int;
    elem_size: int;
    buffer: ptr;

    def new init: int, elem_size: int in
        var self = cast(malloc(__sizeof(Arena)), Arena&);
        self.length = init;
        self.elem_size = elem_size;
        self.buffer = malloc(init * elem_size);
        return self;
    end

    def delete self in
        if self then
            free(self.buffer);
            free(self);
        end
    end

    def at self, idx: int -> ptr in
        if idx < 0 or idx >= self.length then
            printf("ERROR: Arena::at index %d out of bounds (length %d)\n", idx, self.length);
            exit(1);
        end
        return self.buffer + (idx * self.elem_size);
    end

    def set self, idx: int, val: ptr in
        if idx < 0 or idx >= self.length then
            printf("ERROR: Arena::set index %d out of bounds (length %d)\n", idx, self.length);
            exit(1);
        end
        memcpy(self.at(idx), val, self.elem_size);
    end
end
