def x86_64_emit_label cc, ir in
    check_ir_kind(IrKind::Label, ir);
    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out_label(cc, ir_instr_label(ir));
end

def x86_64_emit_ptr_read cc, ir in
    check_ir_kind(IrKind::PtrRead, ir);
    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    var size = ir_instr_size(ir);
    cc_out(cc, "    popq %rax");
    cc_out(cc, "    xorl %edx, %edx");
    var str = String::new(20);
    var reg;
    str.append_cstr("    mov");
    if size == 8 then
        str.push('b');
        reg = "%dl";
    elif size == 16 then
        str.push('w');
        reg = "%dx";
    elif size == 32 then
        str.push('l');
        reg = "%edx";
    elif size == 64 then
        str.push('q');
        reg = "%rdx";
    else
        assert(false,
            "x86_64_emit_ptr_read does not work with sizes outside of 8, 16, 32, 64, size is %d\n",
            size);
    end
    str.append_cstr(" (%rax), ");
    str.append_cstr(reg);
    cc_out(cc, str.cstr());
    str.delete();
    cc_out(cc, "    movq %rdx, %rax");
    cc_out(cc, "    pushq %rax");
end

def x86_64_emit_ptr_write cc, ir in
    check_ir_kind(IrKind::PtrWrite, ir);
    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    var size = ir_instr_size(ir);
    cc_out(cc, "    popq %rax"); // -- ptr
    cc_out(cc, "    popq %rdx"); // -- value
    var str = String::new(20);
    var reg;
    str.append_cstr("    mov");
    if size == 8 then
        str.push('b');
        reg = "%dl";
    elif size == 16 then
        str.push('w');
        reg = "%dx";
    elif size == 32 then
        str.push('l');
        reg = "%edx";
    elif size == 64 then
        str.push('q');
        reg = "%rdx";
    else
        assert(false,
            "x86_64_emit_ptr_write does not work with sizes outside of 8, 16, 32, 64, size is %d\n",
            size);
    end
    str.push(' ');
    str.append_cstr(reg);
    str.append_cstr(", (%rax)");
    cc_out(cc, str.cstr());
    str.delete();
end

def x86_64_emit_ptr_copy cc, ir in
    check_ir_kind(IrKind::PtrCopy, ir);
    //print_ir(ir);
    var bits = ir_instr_size(ir);
    if bits <= 0 then
        return;
    end
    var size = (bits + 7) / 8; // num of bytes to copy
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, "    popq %rax"); // -- dest
    cc_out(cc, "    popq %rdx"); // -- src

    var sse = size / 16;
    size -= sse * 16;
    var movq = size / 8;
    size -= movq * 8;
    var movl = size / 4;
    size -= movl * 4;
    var movw = size / 2;
    size -= movw * 2;
    var movb = size;
    size -= movb * 1;
    assert(size == 0, "x86_64_emit_ptr_copy: didn't resolve size to 0, it was %d\n", size);

    var i = 0; var offs = 0;
    var str = String::new(20);
    while i < sse do
        // load src+offs into xmm0
        str.reset();
        str.append_cstr("    movdqu ");
        str.append_int(offs);
        str.append_cstr("(%rdx), %xmm0");
        cc_out(cc, str.cstr());

        // store xmm0 into dest+offs
        str.reset();
        str.append_cstr("    movups %xmm0, ");
        str.append_int(offs);
        str.append_cstr("(%rax)");
        cc_out(cc, str.cstr());

        i += 1;
        offs += 16;
    end

    while i < movq do
        // load src+offs into rcx
        str.reset();
        str.append_cstr("    movq ");
        str.append_int(offs);
        str.append_cstr("(%rdx), %rcx");
        cc_out(cc, str.cstr());

        // store rcx into dest+offs
        str.reset();
        str.append_cstr("    movq %rcx, ");
        str.append_int(offs);
        str.append_cstr("(%rax)");
        cc_out(cc, str.cstr());

        i += 1;
        offs += 8;
    end

    i = 0;
    while i < movl do
        // load src+offs into ecx
        str.reset();
        str.append_cstr("    movl ");
        str.append_int(offs);
        str.append_cstr("(%rdx), %ecx");
        cc_out(cc, str.cstr());

        // store ecx into dest+offs
        str.reset();
        str.append_cstr("    movl %ecx, ");
        str.append_int(offs);
        str.append_cstr("(%rax)");
        cc_out(cc, str.cstr());

        i += 1;
        offs += 4;
    end

    i = 0;
    while i < movw do
        // load src+offs into cx
        str.reset();
        str.append_cstr("    movw ");
        str.append_int(offs);
        str.append_cstr("(%rdx), %cx");
        cc_out(cc, str.cstr());

        // store cx into dest+offs
        str.reset();
        str.append_cstr("    movw %cx, ");
        str.append_int(offs);
        str.append_cstr("(%rax)");
        cc_out(cc, str.cstr());

        i += 1;
        offs += 2;
    end

    i = 0;
    while i < movb do
        // load src+offs into ecx
        str.reset();
        str.append_cstr("    movzbl ");
        str.append_int(offs);
        str.append_cstr("(%rdx), %ecx");
        cc_out(cc, str.cstr());

        // store cl into dest+offs
        str.reset();
        str.append_cstr("    movb %cl, ");
        str.append_int(offs);
        str.append_cstr("(%rax)");
        cc_out(cc, str.cstr());

        i += 1;
        offs += 1;
    end
    str.delete();
end

def x86_64_emit_ptr_offset cc, ir in
    check_ir_kind(IrKind::PtrOffset, ir);
    //print_ir(ir);
    var offset = ir_instr_offset(ir) / BYTE_BITS;
    if offset == 0 then
        return;
    end
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, "    popq %rax");

    var str = String::new(20);
    str.append_cstr("    leaq ");
    str.append_int(offset);
    str.append_cstr("(%rax), %rax");
    cc_out(cc, str.cstr());
    str.delete();

    cc_out(cc, "    pushq %rax");
end

def x86_64_emit_bit_not cc, ir in
    check_ir_kind(IrKind::BitNot, ir);
    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, "    popq %rax"); // -- a
    cc_out(cc, "    not %rax");
    cc_out(cc, "    pushq %rax");
end

def x86_64_emit_logic_not cc, ir in
    check_ir_kind(IrKind::LogicNot, ir);
    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, "    popq %rax"); // -- a
    cc_out(cc, "    cmpq $0, %rax");
    cc_out(cc, "    sete %al");
    cc_out(cc, "    movzbl %al, %eax");
    cc_out(cc, "    pushq %rax");
end

def x86_64_emit_inline_asm cc, ir in
    check_ir_kind(IrKind::InlineAsm, ir);
    cc_out(cc, "    .align 16");
    cc_out_label(cc, ir_instr_name(ir));
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, ir_instr_asm(ir));
end

def x86_64_emit_lazy_ident cc, ir in
    check_ir_kind(IrKind::LazyIdent, ir);
    NYI_ERR(__FILE__, __LINE__, "IrKind::LazyIdent should have been handled in ir_context.randy");
end

def x86_64_emit_call_lazy_ident cc, ir in
    check_ir_kind(IrKind::CallLazyIdent, ir);
    NYI_ERR(__FILE__, __LINE__, "IrKind::CallLazyIdent should have been handled in ir_context.randy");
end

def x86_64_emit_drop_top cc, ir in
    check_ir_kind(IrKind::DropTop, ir);
    //print_ir(ir);
    cc_out(cc, "    addq $8, %rsp");
end

def x86_64_emit_set_global cc, ir in
    check_ir_kind(IrKind::SetGlobal, ir);
    //print_ir(ir);
    cc_out(cc, "    popq %rax");
    var str = String::new(20);
    str.append_cstr("    movq %rax, (");
    str.append_cstr(ir_instr_label(ir));
    str.append_cstr(")");
    cc_out(cc, str.cstr());
    str.delete();
end

def x86_64_emit_get_global cc, ir in
    check_ir_kind(IrKind::GetGlobal, ir);
    //print_ir(ir);
    var str = String::new(20);
    str.append_cstr("    movq (");
    str.append_cstr(ir_instr_label(ir));
    str.append_cstr("), %rax");
    cc_out(cc, str.cstr());
    cc_out(cc, "    pushq %rax");
    str.delete();
end

def x86_64_emit_ref_global cc, ir in
    check_ir_kind(IrKind::RefGlobal, ir);
    //print_ir(ir);
    var str = String::new(20);
    str.append_cstr("    leaq ");
    str.append_cstr(ir_instr_label(ir));
    str.append_cstr(", %rax");
    cc_out(cc, str.cstr());
    cc_out(cc, "    pushq %rax");
    str.delete();
end

def x86_64_emit_negative cc, ir in
    check_ir_kind(IrKind::Negative, ir);
    //print_ir(ir);
    cc_out(cc, "    popq %rax");
    cc_out(cc, "    neg %rax");
    cc_out(cc, "    pushq %rax");
end

def x86_64_emit_instruction cc: CompilerContext&, ir: IrInstr& in
    var k = ir_instr_kind(ir);
    if k == IrKind::GetLocal then x86_64_emit_get_local(cc, ir);
    elif k == IrKind::PushLabel then x86_64_emit_push_label(cc, ir);
    elif k == IrKind::PushInt then x86_64_emit_push_int(cc, ir);
    elif k == IrKind::AllocTemps then x86_64_emit_alloc_temps(cc, ir);
    elif k == IrKind::FreeTemps then x86_64_emit_free_temps(cc, ir);
    elif k == IrKind::StoreTemp then x86_64_emit_store_temp(cc, ir);
    elif k == IrKind::SetArgTemp then x86_64_emit_set_arg_temp(cc, ir);
    elif k == IrKind::Call then x86_64_emit_call(cc, ir);
    elif k == IrKind::PopCall then x86_64_emit_pop_call(cc, ir);
    elif k == IrKind::OpAdd then x86_64_emit_op_add(cc, ir);
    elif k == IrKind::OpSub then x86_64_emit_op_sub(cc, ir);
    elif k == IrKind::OpMul then x86_64_emit_op_mul(cc, ir);
    elif k == IrKind::OpDiv then x86_64_emit_op_div(cc, ir);
    elif k == IrKind::OpMod then x86_64_emit_op_mod(cc, ir);
    elif k == IrKind::OpEq then x86_64_emit_op_eq(cc, ir);
    elif k == IrKind::OpNotEq then x86_64_emit_op_not_eq(cc, ir);
    elif k == IrKind::OpLess then x86_64_emit_op_less(cc, ir);
    elif k == IrKind::OpLessEq then x86_64_emit_op_less_eq(cc, ir);
    elif k == IrKind::OpGreater then x86_64_emit_op_greater(cc, ir);
    elif k == IrKind::OpGreaterEq then x86_64_emit_op_greater_eq(cc, ir);
    elif k == IrKind::PopReturn then x86_64_emit_pop_return(cc, ir);
    elif k == IrKind::ReturnVoid then x86_64_emit_return_void(cc, ir);
    elif k == IrKind::SetLocal then x86_64_emit_set_local(cc, ir);
    elif k == IrKind::NewDef then x86_64_emit_new_def(cc, ir);
    elif k == IrKind::SetLocalArg then x86_64_emit_set_local_arg(cc, ir);
    elif k == IrKind::CloseDef then x86_64_emit_close_def(cc, ir);
    elif k == IrKind::GotoTopFalse then x86_64_emit_goto_top_false(cc, ir);
    elif k == IrKind::GotoTopTrue then x86_64_emit_goto_top_true(cc, ir);
    elif k == IrKind::GotoFalse then x86_64_emit_goto_false(cc, ir);
    elif k == IrKind::Goto then x86_64_emit_goto(cc, ir);
    elif k == IrKind::Label then x86_64_emit_label(cc, ir);
    elif k == IrKind::PtrRead then x86_64_emit_ptr_read(cc, ir);
    elif k == IrKind::PtrWrite then x86_64_emit_ptr_write(cc, ir);
    elif k == IrKind::BitNot then x86_64_emit_bit_not(cc, ir);
    elif k == IrKind::LogicNot then x86_64_emit_logic_not(cc, ir);
    elif k == IrKind::InlineAsm then x86_64_emit_inline_asm(cc, ir);
    elif k == IrKind::LazyIdent then x86_64_emit_lazy_ident(cc, ir);
    elif k == IrKind::CallLazyIdent then x86_64_emit_call_lazy_ident(cc, ir);
    elif k == IrKind::DropTop then x86_64_emit_drop_top(cc, ir);
    elif k == IrKind::SetGlobal then x86_64_emit_set_global(cc, ir);
    elif k == IrKind::GetGlobal then x86_64_emit_get_global(cc, ir);
    elif k == IrKind::Negative then x86_64_emit_negative(cc, ir);
    elif k == IrKind::OpBitXOR then x86_64_emit_op_bit_xor(cc, ir);
    elif k == IrKind::OpBitAND then x86_64_emit_op_bit_and(cc, ir);
    elif k == IrKind::OpBitOR then x86_64_emit_op_bit_or(cc, ir);
    elif k == IrKind::OpBitShiftL then x86_64_emit_op_bit_shift_l(cc, ir);
    elif k == IrKind::OpBitShiftR then x86_64_emit_op_bit_shift_r(cc, ir);
    elif k == IrKind::ScopeOpen then // nothing to do
    elif k == IrKind::ScopeClose then // nothing to do
    elif k == IrKind::PtrCopy then x86_64_emit_ptr_copy(cc, ir);
    elif k == IrKind::PtrOffset then x86_64_emit_ptr_offset(cc, ir);
    elif k == IrKind::RefLocal then x86_64_emit_ref_local(cc, ir);
    elif k == IrKind::RefGlobal then x86_64_emit_ref_global(cc, ir);
    else
        printf("`x86_64_emit_instruction` in File \"%s\", line %d\n", __FILE__, __LINE__);
        printf("Unhandled IRK: %s (%d)\n", ir_instr_kind_cstr(k), k);
        print_ir(ir);
        exit(1);
    end
end

def x86_64_emit_start cc: CompilerContext&, main_def: cstr, exit_def: cstr in
    cc_out(cc, "    .global _start");
    cc_out(cc, "    .align 16");
    cc_out(cc, "_start:");
    cc_out(cc, "    movq (%rsp), %rdi");
    cc_out(cc, "    movq %rsp, %rsi");
    cc_out(cc, "    addq $8, %rsi");
    cc_out(cc, "    movq %rdi, (__argc__)");
    cc_out(cc, "    movq %rsi, (__argv__)");
    var str = String::new(0);
    str.append_cstr("    call ");
    str.append_cstr(main_def);
    cc_out(cc, str.cstr());
    cc_out(cc, "    movq %rax, %rdi");
    if exit_def then
        str.reset();
        str.append_cstr("    call ");
        str.append_cstr(exit_def);
        cc_out(cc, str.cstr());
    end
    cc_out(cc, "    movq $60, %rax");
    cc_out(cc, "    syscall");
    cc_out(cc, "    int3");
end
