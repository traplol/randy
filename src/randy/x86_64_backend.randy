def _x86_64_emit_compare cc, op in
    cc_out(cc, "    popq %r10"); // -- a
    cc_out(cc, "    popq %r11"); // -- a
    cc_out(cc, "    xorl %eax, %eax");
    cc_out(cc, "    cmpq %r10, %r11");
    var str = String::new(20);
    str.append_cstr("    ");
    str.append_cstr(op);
    str.append_cstr(" %al");
    cc_out(cc, str.cstr());
    str.delete();
    cc_out(cc, "    pushq %rax");
end

