    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, "    popq %rdx"); // -- b
    cc_out(cc, "    popq %rax"); // -- a
    cc_out(cc, "    addq %rdx, %rax");
    cc_out(cc, "    pushq %rax");
end

