    check_ir_kind(IrKind::GotoTopFalse, ir);
    //print_ir(ir);
    cc_out_src_loc(cc, ir_instr_src_loc(ir));
    cc_out(cc, "    cmpq $0, (%rsp)");
    var str = String::new(20);
    str.append_cstr("    je ");
    str.append_cstr(ir_instr_label(ir));
    cc_out(cc, str.cstr());
    str.delete();
    cc_out(cc, "    addq $8, %rsp");
end

