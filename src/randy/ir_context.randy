
enum IrKind in
    GetLocal;       // 0
    PushLabel;      // 1
    PushInt;        // 2
    AllocTemps;     // 3
    FreeTemps;      // 4
    StoreTemp;      // 5
    SetArgTemp;     // 6
    Call;           // 7
    PopCall;        // 8
    Plus;           // 9  (unused, kept for numbering)
    OpAdd;          // 10
    OpSub;          // 11
    OpMul;          // 12
    OpDiv;          // 13
    OpMod;          // 14
    OpEq;           // 15
    OpNotEq;        // 16
    OpLess;         // 17
    OpLessEq;       // 18
    OpGreater;      // 19
    OpGreaterEq;    // 20
    PopReturn;      // 21
    ReturnVoid;     // 22
    SetLocal;       // 23
    NewDef;         // 24
    SetLocalArg;    // 25
    CloseDef;       // 26
    GotoTopFalse;   // 27
    GotoTopTrue;    // 28
    GotoFalse;      // 29
    Goto;           // 30
    Label;          // 31
    PtrRead;        // 32
    PtrWrite;       // 33
    BitNot;         // 34
    LogicNot;       // 35
    LogicAnd;       // 36 (unused, kept for numbering)
    LogicOr;        // 37 (unused, kept for numbering)
    InlineAsm;      // 38
    LazyIdent;      // 39
    CallLazyIdent;  // 40
    DropTop;        // 41
    SetGlobal;      // 42
    GetGlobal;      // 43
    Negative;       // 44
    OpBitXOR;       // 45
    OpBitAND;       // 46
    OpBitOR;        // 47
    OpBitShiftL;    // 48
    OpBitShiftR;    // 49
    ScopeOpen;      // 50
    ScopeClose;     // 51
    PtrCopy;        // 52
    PtrOffset;      // 53
    RefLocal;       // 54
    RefGlobal;      // 55
end

def ir_instr_kind_cstr k: IrKind -> cstr in
    if k == IrKind::GetLocal then return "IrKind::GetLocal"; end
    if k == IrKind::PushLabel then return "IrKind::PushLabel"; end
    if k == IrKind::PushInt then return "IrKind::PushInt"; end
    if k == IrKind::AllocTemps then return "IrKind::AllocTemps"; end
    if k == IrKind::FreeTemps then return "IrKind::FreeTemps"; end
    if k == IrKind::StoreTemp then return "IrKind::StoreTemp"; end
    if k == IrKind::SetArgTemp then return "IrKind::SetArgTemp"; end
    if k == IrKind::Call then return "IrKind::Call"; end
    if k == IrKind::PopCall then return "IrKind::PopCall"; end
    if k == IrKind::OpAdd then return "IrKind::OpAdd"; end
    if k == IrKind::OpSub then return "IrKind::OpSub"; end
    if k == IrKind::OpMul then return "IrKind::OpMul"; end
    if k == IrKind::OpDiv then return "IrKind::OpDiv"; end
    if k == IrKind::OpMod then return "IrKind::OpMod"; end
    if k == IrKind::OpEq then return "IrKind::OpEq"; end
    if k == IrKind::OpNotEq then return "IrKind::OpNotEq"; end
    if k == IrKind::OpLess then return "IrKind::OpLess"; end
    if k == IrKind::OpLessEq then return "IrKind::OpLessEq"; end
    if k == IrKind::OpGreater then return "IrKind::OpGreater"; end
    if k == IrKind::OpGreaterEq then return "IrKind::OpGreaterEq"; end
    if k == IrKind::PopReturn then return "IrKind::PopReturn"; end
    if k == IrKind::ReturnVoid then return "IrKind::ReturnVoid"; end
    if k == IrKind::SetLocal then return "IrKind::SetLocal"; end
    if k == IrKind::NewDef then return "IrKind::NewDef"; end
    if k == IrKind::SetLocalArg then return "IrKind::SetLocalArg"; end
    if k == IrKind::CloseDef then return "IrKind::CloseDef"; end
    if k == IrKind::GotoTopFalse then return "IrKind::GotoTopFalse"; end
    if k == IrKind::GotoTopTrue then return "IrKind::GotoTopTrue"; end
    if k == IrKind::GotoFalse then return "IrKind::GotoFalse"; end
    if k == IrKind::Goto then return "IrKind::Goto"; end
    if k == IrKind::Label then return "IrKind::Label"; end
    if k == IrKind::PtrRead then return "IrKind::PtrRead"; end
    if k == IrKind::PtrWrite then return "IrKind::PtrWrite"; end
    if k == IrKind::BitNot then return "IrKind::BitNot"; end
    if k == IrKind::LogicNot then return "IrKind::LogicNot"; end
    if k == IrKind::InlineAsm then return "IrKind::InlineAsm"; end
    if k == IrKind::LazyIdent then return "IrKind::LazyIdent"; end
    if k == IrKind::CallLazyIdent then return "IrKind::CallLazyIdent"; end
    if k == IrKind::DropTop then return "IrKind::DropTop"; end
    if k == IrKind::SetGlobal then return "IrKind::SetGlobal"; end
    if k == IrKind::GetGlobal then return "IrKind::GetGlobal"; end
    if k == IrKind::Negative then return "IrKind::Negative"; end
    if k == IrKind::OpBitXOR then return "IrKind::OpBitXOR"; end
    if k == IrKind::OpBitAND then return "IrKind::OpBitAND"; end
    if k == IrKind::OpBitOR then return "IrKind::OpBitOR"; end
    if k == IrKind::OpBitShiftL then return "IrKind::OpBitShiftL"; end
    if k == IrKind::OpBitShiftR then return "IrKind::OpBitShiftR"; end
    if k == IrKind::ScopeOpen then return "IrKind::ScopeOpen"; end
    if k == IrKind::ScopeClose then return "IrKind::ScopeClose"; end
    if k == IrKind::PtrCopy then return "IrKind::PtrCopy"; end
    if k == IrKind::PtrOffset then return "IrKind::PtrOffset"; end
    if k == IrKind::RefLocal then return "IrKind::RefLocal"; end
    if k == IrKind::RefGlobal then return "IrKind::RefGlobal"; end
    return "IRK_OUT_OF_RANGE";
end

// IrInstr uses union-style overlapping fields:
//   slot_a (offset 16): name / ident / local / label
//   slot_b (offset 24): n / nargs / params / size
//   slot_c (offset 32): value / symbol / varargs / asm / arg / src_name / offset
struct IrInstr in
    kind: IrKind;
    src_loc: SrcLoc&;
    slot_a: ptr;    // name, ident, local, label
    slot_b: ptr;    // n, nargs, params, size
    slot_c: ptr;    // value, symbol, varargs, asm, arg, src_name, offset
    nlocals: int;
    expr_size: int;
    expr_offs: int;

    // slot_a accessors
    def name self -> cstr in return cast(self.slot_a, cstr); end
    def ident self -> Token& in return cast(self.slot_a, Token&); end
    def local self -> int in return cast(self.slot_a, int); end
    def label self -> cstr in return cast(self.slot_a, cstr); end

    // slot_b accessors
    def n self -> int in return cast(self.slot_b, int); end
    def nargs self -> int in return cast(self.slot_b, int); end
    def params self -> Vector[cstr]& in return cast(self.slot_b, Vector[cstr]&); end
    def size self -> int in return cast(self.slot_b, int); end

    // slot_c accessors
    def value self -> int in return cast(self.slot_c, int); end
    def varargs self -> bool in return cast(self.slot_c, bool); end
    def asm_code self -> cstr in return cast(self.slot_c, cstr); end
    def arg self -> int in return cast(self.slot_c, int); end
    def offset self -> int in return cast(self.slot_c, int); end
    def symbol self -> Symbol& in return cast(self.slot_c, Symbol&); end
end

def make_ir_alloc_temps n -> IrInstr& in
    var self = cast(calloc(1, __sizeof(IrInstr)), IrInstr&);
    self.kind = IrKind::AllocTemps;
    self.slot_b = n;
    return self;
end
def make_ir_call label, varargs -> IrInstr& in
    var self = cast(calloc(1, __sizeof(IrInstr)), IrInstr&);
    self.kind = IrKind::Call;
    self.slot_a = label;
    self.slot_c = varargs;
    return self;
end
