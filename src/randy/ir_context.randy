def print_ir_get_global self in
    printf("(IR.GetGlobal ");
    printf("global='%s', ", self.slot_c);
    printf("label='%s')\n", self.slot_a);
end
def print_ir_ref_global self in
    printf("(IR.RefGlobal ");
    printf("global='%s', ", self.slot_c);
    printf("label='%s')\n", self.slot_a);
end
def print_ir ir: IrInstr& in
    var k = ir.kind;
    if k == IrKind::AllocTemps then print_ir_alloc_temps(ir);
    elif k == IrKind::Call then print_ir_call(ir);
    elif k == IrKind::CallLazyIdent then print_ir_call_lazy_ident(ir);
    elif k == IrKind::CloseDef then print_ir_close_def(ir);
    elif k == IrKind::FreeTemps then print_ir_free_temps(ir);
    elif k == IrKind::GetLocal then print_ir_get_local(ir);
    elif k == IrKind::Goto then print_ir_goto(ir);
    elif k == IrKind::GotoFalse then print_ir_goto_false(ir);
    elif k == IrKind::GotoTopFalse then print_ir_goto_top_false(ir);
    elif k == IrKind::GotoTopTrue then print_ir_goto_top_true(ir);
    elif k == IrKind::InlineAsm then print_ir_inline_asm(ir);
    elif k == IrKind::Label then print_ir_label(ir);
    elif k == IrKind::BitNot then print_ir_bit_not(ir);
    elif k == IrKind::LogicNot then print_ir_logic_not(ir);
    elif k == IrKind::NewDef then print_ir_new_def(ir);
    elif k == IrKind::OpAdd then print_ir_op_add(ir);
    elif k == IrKind::OpDiv then print_ir_op_div(ir);
    elif k == IrKind::OpEq then print_ir_op_eq(ir);
    elif k == IrKind::OpGreater then print_ir_op_greater(ir);
    elif k == IrKind::OpGreaterEq then print_ir_op_greater_eq(ir);
    elif k == IrKind::OpLess then print_ir_op_less(ir);
    elif k == IrKind::OpLessEq then print_ir_op_less_eq(ir);
    elif k == IrKind::OpMod then print_ir_op_mod(ir);
    elif k == IrKind::OpMul then print_ir_op_mul(ir);
    elif k == IrKind::OpNotEq then print_ir_op_not_eq(ir);
    elif k == IrKind::OpSub then print_ir_op_sub(ir);
    elif k == IrKind::PopCall then print_ir_pop_call(ir);
    elif k == IrKind::PopReturn then print_ir_pop_return(ir);
    elif k == IrKind::PtrRead then print_ir_ptr_read(ir);
    elif k == IrKind::PtrWrite then print_ir_ptr_write(ir);
    elif k == IrKind::PushInt then print_ir_push_int(ir);
    elif k == IrKind::PushLabel then print_ir_push_label(ir);
    elif k == IrKind::ReturnVoid then print_ir_return_void(ir);
    elif k == IrKind::SetArgTemp then print_ir_set_arg_temp(ir);
    elif k == IrKind::SetLocal then print_ir_set_local(ir);
    elif k == IrKind::SetLocalArg then print_ir_set_local_arg(ir);
    elif k == IrKind::StoreTemp then print_ir_store_temp(ir);
    elif k == IrKind::LazyIdent then print_ir_lazy_ident(ir);
    elif k == IrKind::DropTop then print_ir_drop_top(ir);
    elif k == IrKind::SetGlobal then print_ir_set_global(ir);
    elif k == IrKind::GetGlobal then print_ir_get_global(ir);
    elif k == IrKind::Negative then print_ir_negative(ir);
    elif k == IrKind::ScopeOpen then print_ir_scope_open(ir);
    elif k == IrKind::ScopeClose then print_ir_scope_close(ir);
    elif k == IrKind::PtrCopy then print_ir_ptr_copy(ir);
    elif k == IrKind::PtrOffset then print_ir_ptr_offset(ir);
    elif k == IrKind::RefLocal then print_ir_ref_local(ir);
    elif k == IrKind::RefGlobal then print_ir_ref_global(ir);
    else
        printf("Unknown IR Kind: %d\n", k);
    end
end

struct DefInfo in
    label: cstr;
    _pad: ptr; // padding to match legacy layout (varargs must be at offset 16)
    varargs: bool;
end

def make_def_info label: cstr, varargs: bool -> DefInfo& in
    var self = cast(calloc(1, __sizeof(DefInfo)), DefInfo&);
    self.label = label;
    self.varargs = varargs;
    return self;
end
enum CIK in
    String;
    Integer;
end

struct ConstInfo in
    kind: CIK;
    value: ptr;
    ast_value: Ast&;
end

def make_const_info kind: CIK, value: ptr, ast_value: Ast& -> ConstInfo& in
    var self = cast(malloc(__sizeof(ConstInfo)), ConstInfo&);
    self.kind = kind;
    self.value = value;
    self.ast_value = ast_value;
    return self;
end

enum GlobalInfoKind in
    String;
    Integer;
end

struct GlobalInfo in
    kind: GlobalInfoKind;
    label: cstr;
    value: ptr;
end

def make_global_info kind: GlobalInfoKind, label: cstr, value: ptr -> GlobalInfo& in
    var self = cast(malloc(__sizeof(GlobalInfo)), GlobalInfo&);
    self.kind = kind;
    self.label = label;
    self.value = value;
    return self;
end
struct LocalInfo in
    n: int;
    offs: int;
    size: int;
end

def make_local_info n: int, offs: int, size: int -> LocalInfo& in
    var self = cast(malloc(__sizeof(LocalInfo)), LocalInfo&);
    self.n = n;
    self.offs = offs;
    self.size = size;
    return self;
end
struct TupleLiteral in
    label: cstr;
    slots: int;

    def new label: cstr, slots: int in
        var self = cast(malloc(__sizeof(TupleLiteral)), TupleLiteral&);
        self.label = label;
        self.slots = slots;
        return self;
    end
end

struct IrContext in
    instructions: Vector[IrInstr&]&;
    label_id: int;
    strings: Map&;
    externs: Map&;
    labels: Set[cstr, CstrHashCompare, CstrHashCompare]&;
    constants: Map&;
    src_locs: Vector[SrcLoc&]&;
    file_set: Set[cstr, CstrHashCompare, CstrHashCompare]&;
    files: Vector[cstr]&;
    defs: Map&;
    def_locals: Vector[Map&]&;
    globals_map: Map&;
    globals: Vector[GlobalInfo&]&;
    break_dests: Vector[cstr]&;
    conti_dests: Vector[cstr]&;
    num_locals: int;
    locals_size: int;
    tuple_lits: Vector[TupleLiteral&]&;

    def new in
        var self = cast(calloc(1, __sizeof(IrContext)), IrContext&);
        self.instructions = Vector[IrInstr&]::new(0);
        self.strings = Map::new(0, string_eq, string_hash);
        self.externs = Map::new(0, cstr_eq, cstr_hash);
        self.labels = Set[cstr, CstrHashCompare, CstrHashCompare]::new(0);
        self.constants = Map::new(0, cstr_eq, cstr_hash);
        self.src_locs = Vector[SrcLoc&]::new(0);
        self.file_set = Set[cstr, CstrHashCompare, CstrHashCompare]::new(0);
        self.files = Vector[cstr]::new(0);
        self.defs = Map::new(0, NULL, NULL);
        self.def_locals = Vector[Map&]::new(0);
        self.globals_map = Map::new(0, cstr_eq, cstr_hash);
        self.globals = Vector[GlobalInfo&]::new(0);
        self.break_dests = Vector[cstr]::new(0);
        self.conti_dests = Vector[cstr]::new(0);
        self.tuple_lits = Vector[TupleLiteral&]::new(0);
        return self;
    end
end
def ir_append self, insn in
    insn.src_loc = ir_current_src_loc(self);
    var vec = self.instructions;
    vec.push(insn);
end

def ir_push_src_loc self, src_loc in
    var src_locs = self.src_locs;
    src_locs.push(src_loc);

    var filename = src_loc.filename;
    var fileset = self.file_set;
    if not fileset.contains(filename) then
        fileset.insert(filename);
        var files = self.files;
        files.push(filename);
    end
end

def ir_pop_src_loc self in
    self.src_locs.pop();
end

def ir_current_src_loc self in
    return self.src_locs.back();
end

def ir_push_scope self in
    self.def_locals.push(Map::new(0, cstr_eq, cstr_hash));
    ir_append(self, make_ir_scope_open());
end

def ir_pop_scope self in
    var vec = self.def_locals;
    var m = cast(vec.back(), Map&);
    vec.pop();
    ir_append(self, make_ir_scope_close());
    m.delete();
end

def ir_cur_scope self in
    return self.def_locals.back();
end

def ir_new_def self, ident, params, ast, symbol, tt in
    var defs = self.defs;
    var found = defs.find(ident);
    if found then
        printf("ERROR: def `%s` already defined\n", ident);
        print_ast_src_loc(ast);
        exit(1);
    end

    var label = String::new(20); // @LEAK
    if symbol.owned_by then
        label.push('_');
        label.append_int(type_id(symbol.owned_by));
        label.push('_');
        var name = tt_get_type_name(tt, symbol.owned_by);
        if name then
            label.append_cstr(name);
        end
    end
    label.append_cstr("_def_");
    label.append_cstr(ident);

    var label_cstr = label.cstr();
    self.labels.insert(label_cstr);
    defs.set(symbol.name, make_def_info(label_cstr, false));

    assert(self.def_locals.length == 0,
        "Compiler bug: def locals not empty when creating new def\n");
    self.num_locals = 0;
    self.locals_size = 0;
    symbol.label = label_cstr;
    symbol.is_varargs = false;
    return label_cstr;
end

def ir_new_local self, ident, st in
    var def_locals = self.def_locals;
    var local_idx = 0;
    var offset = 0;
    var i = 0; var len = def_locals.length;
    while i < len do
        var m = def_locals.get(i);
        local_idx += m.length;
        var cur = m.iter_begin();
        while cur != m.iter_end() do
            var li = cast(cur.val, LocalInfo&);
            offset += li.size;
            cur = m.iter_next(cur);
        end
        i += 1;
    end
    var size = 0;
    if g_Experimental then
        var sym = st_get_symbol(st, ident);
        assert(sym);
        var type = sym.type;
        assert(type);
        size = type_size(type);
        if offset + size > self.locals_size then
            self.locals_size = offset + size;
        end

    end
    ir_cur_scope(self).set(ident, make_local_info(local_idx, offset, size));
    if local_idx + 1 > self.num_locals then
        self.num_locals = local_idx + 1;
    end
    return local_idx;
end

def ir_new_label self, hint in
    var label_id = self.label_id;
    self.label_id = label_id + 1;

    var label = String::new(13); // @LEAK
    label.append_cstr(".L");
    if hint then
        label.append_cstr(hint);
    end
    label.append_int(label_id);

    var label_cstr = label.cstr();
    self.labels.insert(label_cstr);
    return label_cstr;
end

def ir_string_label self, string in
    var strings = self.strings;
    var found = strings.find(string);
    if found then
        return found.val;
    end

    var label = ir_new_label(self, "C");
    self.labels.insert(label);
    strings.set(string, label);

    return label;
end

def ir_tuple_label self, slots in
    var label = ir_new_label(self, "T");
    self.labels.insert(label);
    self.tuple_lits.push(TupleLiteral::new(label, slots));
    return label;
end

def ir_is_label self, ident in
    return self.labels.contains(ident);
end

def ir_is_def self, ident in
    //var sym = st_get_symbol(g_SymbolTable, ident);
    if self.defs.find(ident) != NULL then
        return true;
    else
        return false;
    end
end

def ir_get_def self, ident -> DefInfo& in
    var found = self.defs.find(ident);
    return cast(found.val, DefInfo&);
end

def ir_is_extern self, ident in
    return self.externs.find(ident) != NULL;
end

def ir_get_extern self, ident -> DefInfo& in
    var found = self.externs.find(ident);
    return cast(found.val, DefInfo&);
end

def ir_add_extern self, ident, params, is_varargs in
    var def_info = make_def_info(ident, is_varargs);
    self.externs.set(ident, def_info);
end

def ir_is_local self, ident in
    var def_locals = self.def_locals;
    var i = 0; var len = def_locals.length;
    while i < len do
        if def_locals.get(i).find(ident) then
            return true;
        end
        i += 1;
    end
    return false;
end

def ir_is_cur_scope_local self, ident in
    if ir_cur_scope(self).find(ident) then
        return true;
    end
    return false;
end

def ir_get_local self, ident -> int in
    var def_locals = self.def_locals;
    var i = def_locals.length - 1;
    var found;
    while i >= 0 do
        found = def_locals.get(i).find(ident);
        if found then
            return cast(found.val, LocalInfo&).n;
        end
        i -= 1;
    end
    assert(false, "Compiler bug: didn't check `ir_is_local` before calling `ir_get_local`\n");
end

def ir_get_local_offset self, ident -> int in
    var def_locals = self.def_locals;
    var i = def_locals.length - 1;
    var found;
    while i >= 0 do
        found = def_locals.get(i).find(ident);
        if found then
            return cast(found.val, LocalInfo&).offs;
        end
        i -= 1;
    end
    assert(false, "Compiler bug: didn't check `ir_is_local` before calling `ir_get_local_offset`\n");
end

def ir_is_const self, ident in
    return self.constants.find(ident) != NULL;
end

def ir_get_const self, ident in
    var found = self.constants.find(ident);
    return cast(found.val, ConstInfo&);
end

def ir_add_const self, ident, value in
    self.constants.set(ident, value);
end

def ir_is_global self, ident in
    return self.globals_map.find(ident) != NULL;
end

def ir_get_global self, ident -> GlobalInfo& in
    var found = self.globals_map.find(ident);
    return cast(found.val, GlobalInfo&);
end

def ir_add_global_string self, ident, value in
    var label = ir_new_label(self, "G");
    var val_label = ir_string_label(self, value);
    var gi = make_global_info(GlobalInfoKind::String, label, val_label);
    self.globals_map.set(ident, gi);
    self.globals.push(gi);
end

def ir_add_global_int self, ident, value in
    var label = ir_new_label(self, "G");
    var gi = make_global_info(GlobalInfoKind::Integer, label, value);
    self.globals_map.set(ident, gi);
    self.globals.push(gi);
end

def ir_push_break_dest self, dest in
    self.break_dests.push(dest);
end

def ir_pop_break_dest self in
    self.break_dests.pop();
end

def ir_get_break_dest self in
    var dests = self.break_dests;
    if dests.length == 0 then
        return NULL;
    end
    return dests.back();
end

def ir_push_continue_dest self, dest in
    self.conti_dests.push(dest);
end

def ir_pop_continue_dest self in
    self.conti_dests.pop();
end

def ir_get_continue_dest self in
    var dests = self.conti_dests;
    if dests.length == 0 then
        return NULL;
    end
    return dests.back();
end

def ir_emit_body self, body, st, tt in
    var i = 0;
    var len = body.length;
    while i < len do
        var ast = body.get(i);
        ir_compile(self, ast, st, tt);
        if ast.is_expr then
            ir_append(self, make_ir_drop_top());
        end
        i += 1;
    end
end

def ir_emit_ident self, ast, st, tt in
    check_ast_kind(AstK::Ident, ast);

    var ident = ast.u.ident;
    if ir_is_local(self, ident) then
        var n = ir_get_local(self, ident);
        var offs = ir_get_local_offset(self, ident);
        ir_append(self, make_ir_get_local(ident, n, offs));
    elif ir_is_const(self, ident) then
        var const_info = ir_get_const(self, ident);
        if const_info.kind == CIK::Integer then
            ir_append(self, make_ir_push_int(const_info.value));
        elif const_info.kind == CIK::String then
            ir_append(self, make_ir_push_label(const_info.value));
        else
            printf("Unhandled const_info kind: %d\n", const_info.kind);
            NYI_ERR(__FILE__, __LINE__, "ir_emit_ident:const");
        end
    elif ir_is_def(self, ident) then
        var def_info = ir_get_def(self, ident);
        ir_append(self, make_ir_push_label(def_info.label));
    elif ir_is_extern(self, ident) then
        var extern_info = ir_get_extern(self, ident);
        ir_append(self, make_ir_push_label(extern_info.label));
    elif ir_is_global(self, ident) then
        var gi = ir_get_global(self, ident);
        ir_append(self, make_ir_get_global(ident, gi.label));
    else
        ir_append(self, make_ir_lazy_ident(ast.token, st_get_symbol(st, ident)));
    end
end

def ir_emit_integer self, ast, st, tt in
    check_ast_kind(AstK::Integer, ast);
    ir_append(self, make_ir_push_int(ast.u.integer));
end

def ir_emit_string self, ast, st, tt in
    check_ast_kind(AstK::String, ast);
    var string = ast.u.string;
    var string_label = ir_string_label(self, string);
    ir_append(self, make_ir_push_label(string_label));
end

def ir_emit_call self, ast, st, tt in
    check_ast_kind(AstK::Call, ast);
    var args = ast.u.call.args;
    var len = args.length;
    if len > 0 then
        ir_append(self, make_ir_alloc_temps(len));
    end
    var i = 0;
    while i < len do
        ir_compile(self, args.get(i), st, tt);
        ir_append(self, make_ir_store_temp(i));
        i += 1;
    end

    i = 0;
    while i < len do
        ir_append(self, make_ir_set_arg_temp(i));
        i += 1;
    end
    if len > 0 then
        ir_append(self, make_ir_free_temps(len));
    end

    var expr = ast.u.call.expr;
    if expr.kind == AstK::Ident then
        var ident = expr.u.ident;
        var info;
        if ir_is_def(self, ident) then
            info = ir_get_def(self, ident);
            ir_append(self, make_ir_call(info.label, info.varargs));
        elif ir_is_extern(self, ident) then
            info = ir_get_extern(self, ident);
            ir_append(self, make_ir_call(info.label, info.varargs));
        elif ir_is_label(self, ident) then
            ir_append(self, make_ir_call(ident, false));
        elif ir_is_local(self, ident) then
            ir_compile(self, expr, st, tt);
            ir_append(self, make_ir_pop_call());
        else
            ir_append(self, make_ir_call_lazy_ident(expr.token, st_get_symbol(st, ident), len));
        end
    elif expr.kind == AstK::ScopeResolve then
        var def_ = scope_resolve_def(tt, expr, true);
        assert(def_);
        if def_.label then
            ir_append(self, make_ir_call(def_.label, def_.is_varargs));
        else
            ir_append(self, make_ir_call_lazy_ident(expr.token, def_, len));
        end
    else
        ir_compile(self, expr, st, tt);
        ir_append(self, make_ir_pop_call());
    end
end

def ir_emit_logic_and self, ast, st, tt in
    var label = ir_new_label(self, NULL);
    ir_compile(self, ast.u.binop.lhs, st, tt);
    ir_append(self, make_ir_goto_top_false(label));
    ir_compile(self, ast.u.binop.rhs, st, tt);
    ir_append(self, make_ir_label(label));
end

def ir_emit_logic_or self, ast, st, tt in
    var label = ir_new_label(self, NULL);
    ir_compile(self, ast.u.binop.lhs, st, tt);
    ir_append(self, make_ir_goto_top_true(label));
    ir_compile(self, ast.u.binop.rhs, st, tt);
    ir_append(self, make_ir_label(label));
end

def ir_emit_binop self, ast, st, tt in
    check_ast_kind(AstK::BinOp, ast);
    var op = ast.u.binop.op;
    var simple: IrKind = cast(-1, IrKind);
    if op == TK::Plus then simple = IrKind::OpAdd;
    elif op == TK::Minus then simple = IrKind::OpSub;
    elif op == TK::Star then simple = IrKind::OpMul;
    elif op == TK::Slash then simple = IrKind::OpDiv;
    elif op == TK::Percent then simple = IrKind::OpMod;
    elif op == TK::EqEq then simple = IrKind::OpEq;
    elif op == TK::NotEq then simple = IrKind::OpNotEq;
    elif op == TK::Less then simple = IrKind::OpLess;
    elif op == TK::Greater then simple = IrKind::OpGreater;
    elif op == TK::LessEq then simple = IrKind::OpLessEq;
    elif op == TK::GreaterEq then simple = IrKind::OpGreaterEq;
    elif op == TK::Caret then simple = IrKind::OpBitXOR;
    elif op == TK::Amper then simple = IrKind::OpBitAND;
    elif op == TK::Bar then simple = IrKind::OpBitOR;
    elif op == TK::LShift then simple = IrKind::OpBitShiftL;
    elif op == TK::RShift then simple = IrKind::OpBitShiftR;
    elif op == TK::KW_and then ir_emit_logic_and(self, ast, st, tt);
    elif op == TK::KW_or then ir_emit_logic_or(self, ast, st, tt);
    else
        printf("Unhandled binop: %d\n", op);
        print_token(ast.token);
        NYI_ERR(__FILE__, __LINE__, "ir_emit_binop");
    end
    if cast(simple, int) >= 0 then
        ir_compile(self, ast.u.binop.lhs, st, tt);
        ir_compile(self, ast.u.binop.rhs, st, tt);
        ir_append(self, make_ir_simple_op(simple));
    end
end

def ir_emit_return self, ast, st, tt in
    check_ast_kind(AstK::Return, ast);
    var expr = ast.u.return_;
    if not expr then
        ir_append(self, make_ir_return_void());
        return;
    end
    ir_compile(self, expr, st, tt);
    ir_append(self, make_ir_pop_return());
end

def ir_emit_var_decl self, ast, st, tt in
    check_ast_kind(AstK::VarDecl, ast);
    var ident = ast.u.var_decl;
    assert(not ir_is_cur_scope_local(self, ident),
        "Compiler bug: Error should have been handled earlier.\n");
    var sym = st_get_symbol(st, ident);
    assert(sym);
    var sym_type = sym.type;
    assert(sym_type and type_size(sym_type) != 0,
        "Compiler bug: Error should have been handled in type checker.\n");
    ir_new_local(self, ident, st);
end

def ir_emit_var_assign self, ast, st, tt in
    check_ast_kind(AstK::VarAssign, ast);
    var ident = ast.u.var_assign.ident;
    assert(not ir_is_cur_scope_local(self, ident),
        "Compiler bug: Error should have been handled earlier.\n");
    var sym = st_get_symbol(st, ident);
    assert(sym);
    var sym_type = sym.type;
    assert(sym_type and type_size(sym_type) != 0,
        "Compiler bug: Error should have been handled in type checker.\n");
    var val = ast.u.var_assign.expr;
    ir_compile(self, val, st, tt);
    var n = ir_new_local(self, ident, st);
    var offs = ir_get_local_offset(self, ident);
    ir_append(self, make_ir_set_local(ident, n, offs));
end

def ir_emit_assign_op self, ast, st, tt in
    check_ast_kind(AstK::AssignOp, ast);
    var ident = ast.u.assign_op.ident;
    var op = ast.u.assign_op.op;
    if op != TK::Assign then
        if ir_is_local(self, ident) then
            var n = ir_get_local(self, ident);
            var offs = ir_get_local_offset(self, ident);
            ir_append(self, make_ir_get_local(ident, n, offs));
        elif ir_is_global(self, ident) then
            var gi = ir_get_global(self, ident);
            var label = gi.label;
            ir_append(self, make_ir_get_global(ident, label));
            else
        //ir_append(self, make_ir_lazy_ident(ast.token));
        printf("TODO: This can be fixed in the compiler by implementing IRK_SetLazyIdent\n");
        printf("ERROR: No variable named `%s` exists.\n", ident);
        print_ast_src_loc(ast);
        exit(1);
        end
    end
    ir_compile(self, ast.u.assign_op.expr, st, tt);

    var ir_op: IrKind = cast(-1, IrKind);
    if op == TK::PlusEq then ir_op = IrKind::OpAdd;
    elif op == TK::MinusEq then ir_op = IrKind::OpSub;
    elif op == TK::StarEq then ir_op = IrKind::OpMul;
    elif op == TK::SlashEq then ir_op = IrKind::OpDiv;
    elif op == TK::PercentEq then ir_op = IrKind::OpMod;
    elif op == TK::LShiftEq then ir_op = IrKind::OpBitShiftL;
    elif op == TK::RShiftEq then ir_op = IrKind::OpBitShiftR;
    elif op == TK::AmperEq then ir_op = IrKind::OpBitAND;
    elif op == TK::CaretEq then ir_op = IrKind::OpBitXOR;
    elif op == TK::BarEq then ir_op = IrKind::OpBitOR;
    elif op == TK::Assign then // nothing
    else
        print_ast_src_loc(ast);
        assert(false, "Compiler bug: Unhandled assign op: %d\n", op);
    end

    if op != TK::Assign then
        assert(cast(ir_op, int) != -1, "Compiler bug: ir_op wasn't assigned. op = %d\n", op);
        ir_append(self, make_ir_simple_op(ir_op));
    end

    if ir_is_local(self, ident) then
        var n = ir_get_local(self, ident);
        var offs = ir_get_local_offset(self, ident);
        ir_append(self, make_ir_set_local(ident, n, offs));
    elif ir_is_global(self, ident) then
        var gi = ir_get_global(self, ident);
        var label = gi.label;
        ir_append(self, make_ir_set_global(ident, label));
    else
        print_ast_src_loc(ast);
        assert(false, "Compiler bug: Unhandled assignment for non-local and non-global\n");
    end
end

def ir_emit_assign_member self, ast, st, tt in
    check_ast_kind(AstK::AssignMember, ast);
    var lhs = ast.u.assign_member.lhs;
    var rhs = ast.u.assign_member.rhs;
    var op = ast.u.assign_member.op;

    if op != TK::Assign then
        if lhs.kind == AstK::MemberAccess then
            // dereference self
            ir_emit_member_access(self, lhs, st, tt, true);
        else
            ir_compile(self, lhs, st, tt);
        end
    end

    ir_compile(self, rhs, st, tt);

    var ir_op: IrKind = cast(-1, IrKind);
    if op == TK::PlusEq then ir_op = IrKind::OpAdd;
    elif op == TK::MinusEq then ir_op = IrKind::OpSub;
    elif op == TK::StarEq then ir_op = IrKind::OpMul;
    elif op == TK::SlashEq then ir_op = IrKind::OpDiv;
    elif op == TK::PercentEq then ir_op = IrKind::OpMod;
    elif op == TK::LShiftEq then ir_op = IrKind::OpBitShiftL;
    elif op == TK::RShiftEq then ir_op = IrKind::OpBitShiftR;
    elif op == TK::AmperEq then ir_op = IrKind::OpBitAND;
    elif op == TK::CaretEq then ir_op = IrKind::OpBitXOR;
    elif op == TK::BarEq then ir_op = IrKind::OpBitOR;
    elif op == TK::Assign then // nothing
    else
        print_ast_src_loc(ast);
        assert(false, "Compiler bug: Unhandled assign op: %d\n", op);
    end

    if op != TK::Assign then
        assert(cast(ir_op, int) != -1, "Compiler bug: ir_op wasn't assigned. op = %d\n", op);
        ir_append(self, make_ir_simple_op(ir_op));
    end

    if lhs.kind == AstK::MemberAccess then
        ir_emit_member_access(self, lhs, st, tt, false);
    else
        ir_compile(self, lhs, st, tt);
    end
    var lhs_type = tt_get_ast_type(tt, lhs);
    var size = type_size(lhs_type);
    ir_append(self, make_ir_ptr_write(size));
end

def ir_emit_def self, ast, st, tt in
    check_ast_kind(AstK::Def, ast);
    var ident = ast.u.def_.ident;
    var params = ast.u.def_.params;
    var label = ir_new_def(self, ident, params, ast, st_get_symbol(st, ident), tt);
    var insn = make_ir_new_def(ident, label, params);
    ir_push_scope(self);
    ir_append(self, insn);

    var i = 0; var len = params.length;
    while i < len do
        var param = params.get(i);
        var n = ir_new_local(self, param, st);
        var offs = ir_get_local_offset(self, param);
        ir_append(self, make_ir_set_local_arg(param, n, i, offs));
        i += 1;
    end
    ir_emit_body(self, ast.u.def_.body, st, tt);
    insn.nlocals = self.num_locals;
    insn.expr_size = self.locals_size;
    ir_append(self, make_ir_close_def(ident, label));
    ir_pop_scope(self);
end

def ir_emit_if_else self, ast, st, tt in
    check_ast_kind(AstK::IfElse, ast);
    var test = ast.u.if_else.test;
    var conseq = ast.u.if_else.consequence;
    var altern = ast.u.if_else.alternative;
    if _comptime_is_int(1, test) then
        ir_push_scope(self);
        ir_emit_body(self, conseq, st, tt);
        ir_pop_scope(self);
    elif _comptime_is_int(0, test) then
        ir_push_scope(self);
        ir_emit_body(self, altern, st, tt);
        ir_pop_scope(self);
    else
        var l_else = ir_new_label(self, NULL);
        var l_out = ir_new_label(self, NULL);
        ir_compile(self, test, st, tt);
        ir_append(self, make_ir_goto_false(l_else));
        ir_push_scope(self);
        ir_emit_body(self, conseq, st, tt);
        ir_pop_scope(self);
        ir_append(self, make_ir_goto(l_out));

        ir_append(self, make_ir_label(l_else));
        ir_push_scope(self);
        ir_emit_body(self, altern, st, tt);
        ir_pop_scope(self);
        ir_append(self, make_ir_label(l_out));
    end
end

def ir_emit_while self, ast, st, tt in
    check_ast_kind(AstK::While, ast);
    var l_test = ir_new_label(self, NULL);
    var l_out = ir_new_label(self, NULL);
    ir_push_scope(self);
    ir_append(self, make_ir_label(l_test));
    ir_compile(self, ast.u.while_.test, st, tt);
    ir_append(self, make_ir_goto_false(l_out));
    ir_push_break_dest(self, l_out);     // break jumps to out
    ir_push_continue_dest(self, l_test); // continue jumps to test
    ir_emit_body(self, ast.u.while_.body, st, tt);
    ir_pop_continue_dest(self);
    ir_pop_break_dest(self);
    ir_append(self, make_ir_goto(l_test));
    ir_append(self, make_ir_label(l_out));
    ir_pop_scope(self);
end

def ir_emit_pointer_op self, ast, st, tt in
    //check_ast_kind(AstK::PointerOp, ast);
    var args = ast.u.ptr_op.args;
    var size = ast.u.ptr_op.size;
    if size == 0 then
        var type_ast = args.back();
        assert(type_ast.kind == AstK::Type);
        var type = type_ast.u.type;
        size = type_size(type);
    end
    var op = ast.u.ptr_op.op;
    if op == PointerOp::Read then
        ir_compile(self, args.get(0), st, tt);
        ir_append(self, make_ir_ptr_read(size));
    elif op == PointerOp::Write then
        // Pointer ops expect the pointer to be at top of stack so we compile in reverse order.
        ir_compile(self, args.get(1), st, tt);
        ir_compile(self, args.get(0), st, tt);
        ir_append(self, make_ir_ptr_write(size));
    else
        NYI_ERR(__FILE__, __LINE__, "unhandled ir_emit_pointer_op");
    end
end

def ir_emit_prefix_op self, ast, st, tt in
    check_ast_kind(AstK::Prefix, ast);
    var expr = ast.u.prefix.expr;
    var op = ast.u.prefix.op;
    if op == TK::Tilde then
        ir_compile(self, expr, st, tt);
        ir_append(self, make_ir_bit_not());
    elif op == TK::KW_not then
        ir_compile(self, expr, st, tt);
        ir_append(self, make_ir_logic_not());
    elif op == TK::Minus then
        if expr.kind == AstK::Integer then
            ir_append(self, make_ir_push_int(0 - expr.u.integer));
        else
            ir_compile(self, expr, st, tt);
            ir_append(self, make_ir_negative());
        end
    else
        NYI_ERR(__FILE__, __LINE__, "unhandled ir_emit_prefix_op");
    end
end

def ir_emit_const self, ast, st, tt in
    check_ast_kind(AstK::Const, ast);
    var expr = ast.u.const_.expr;
    var const_info: ConstInfo& = NULL;
    var k = expr.kind;
    if k == AstK::String then
        var string_label = ir_string_label(self, expr.u.string);
        const_info = make_const_info(CIK::String, string_label, expr);
    elif k == AstK::Integer then
        const_info = make_const_info(CIK::Integer, expr.u.integer, expr);
    end
    if const_info then
        if ir_is_const(self, ast.u.const_.ident) then
            var existing = ir_get_const(self, ast.u.const_.ident);
            if existing.kind != const_info.kind or
                existing.value != const_info.value then
                printf("ERROR: Cannot redefine a const `%s` to a new value.\n", ast.u.const_.ident);
                print_ast_src_loc(ast);
                exit(1);
            end
        else
            ir_add_const(self, ast.u.const_.ident, const_info);
        end
    else
        NYI_ERR(__FILE__, __LINE__, "ir_emit_const_comptime: unsupported constant");
    end
end

def ir_emit_extern self, ast, st, tt in
    check_ast_kind(AstK::Extern, ast);
    var ident = ast.u.extern_.ident;
    var type = ast.u.extern_.type;
    var is_varargs = false;
    if type_is_def(type) then
        is_varargs = type_def_varargs(type);
    end
    ir_add_extern(self, ident, NULL, is_varargs);
end

def ir_emit_inline_asm self, ast, st, tt in
    // TODO: Check if asm name already defined.
    check_ast_kind(AstK::InlineAsm, ast);
    var asm_name = ast.u.inline_asm.ident;
    var asm_code = ast.u.inline_asm.asmcode;
    ir_append(self, make_ir_inline_asm(asm_name, asm_code));
    self.labels.insert(asm_name);
end

def ir_emit_global self, ast, st, tt in
    check_ast_kind(AstK::Global, ast);
    var ident = ast.u.global_.ident;
    if ir_is_global(self, ident) then
        printf("ERROR: global `%s` already defined.\n", ident);
        print_ast_src_loc(ast);
        exit(1);
    end

    var expr = ast.u.global_.expr;
    var k = expr.kind;
    if k == AstK::String then
        ir_add_global_string(self, ident, expr.u.string);
    elif k == AstK::Integer then
        ir_add_global_int(self, ident, expr.u.integer);
    else
        NYI_ERR(__FILE__, __LINE__, "ir_emit_global:comptime failed");
    end
end

def ir_emit_break self, ast, st, tt in
    check_ast_kind(AstK::Break, ast);
    var dest = ir_get_break_dest(self);
    if not dest then
        printf("ERROR: 'break' must be within a loop body.\n");
        print_ast_src_loc(ast);
        exit(1);
    end
    ir_append(self, make_ir_goto(dest));
end

def ir_emit_continue self, ast, st, tt in
    check_ast_kind(AstK::Continue, ast);
    var dest = ir_get_continue_dest(self);
    if not dest then
        printf("ERROR: 'continue' must be within a loop body.\n");
        print_ast_src_loc(ast);
        exit(1);
    end
    ir_append(self, make_ir_goto(dest));
end

def ir_emit_struct self, ast, st, tt in
    check_ast_kind(AstK::Struct, ast);
end

def ir_emit_enum self, ast, st, tt in
    check_ast_kind(AstK::Enum, ast);
end

def ir_emit_union self, ast, st, tt in
    check_ast_kind(AstK::Union, ast);
end

def ir_emit_member_access self, ast, st, tt, deref: bool in
    check_ast_kind(AstK::MemberAccess, ast);

    // Member access is essentially a left-associative binary operator and when
    // they are chained together in the form of `a.b.c.d`, they act as a linked
    // list of more MemberAccess. We can utilize this by walking the list backwards
    // and calculating the exact offset.
    // At some point this will need to be adapted for dereferencing reference types.

    var offset = 0;
    var head = ast;
    var deref_stack = Vector[int]::new(0);
    while head.kind == AstK::MemberAccess do
        var member = head.u.member_access.member;
        var type = tt_get_ast_type(tt, head.u.member_access.expr);
        var _type = type;
        while type_is_reference(_type) do
            _type = type_deref_type(_type);
        end
        assert(type_is_struct(_type) or type_is_union(_type),
               "Error should have been reported in type checker\n");
        var fields;
        if type_is_struct(_type) then
            fields = type_struct_fields(_type);
        elif type_is_union(_type) then
            fields = type_union_fields(_type);
        end
        var field: Field& = NULL;
        var i = 0; var len = fields.length;
        while i < len do
            field = fields.get(i);
            if cstr_eq(field.name, member) then
                break;
            end
            i += 1;
        end
        // This assert is < and not <= because a successful find breaks early and
        // if i == len, this means we didn't find the field which is either a bug
        // in the type inference or we're trying to emit def lookup which
        // isn't implemented yet.
        assert(i < len, "TODO: update ir_emit_member_access for defs\n");
        assert(field, "Compiler bug: field should not be NULL\n");
        var offs = field.bit_offset;
        assert(offs >= 0, "Compiler bug: field offset should be >= 0\n");
        offset += offs;
        if type_is_reference(type) then
            deref_stack.push(offset);
            offset = 0;
        end
        head = head.u.member_access.expr;
    end

    var head_type = tt_get_ast_type(tt, head);
    assert(head_type);
    if type_is_struct(head_type) and head.kind == AstK::Ident then
        // For the time being, we can allow small structs that fit inside a register to trivially
        // be stack allocated.
        if head_type.size > PTR_BITS then
            assert(false, "stack allocations not supported yet. type size = %d\n", head_type.size);
        end
    end
    ir_compile(self, head, st, tt);

    if offset != 0 then
        deref_stack.push(offset);
    end
    var i = deref_stack.length - 1;
    while i >= 0 do
        ir_append(self, make_ir_ptr_offs(deref_stack.get(i)));
        if i > 0 then
            ir_append(self, make_ir_ptr_read(PTR_BITS));
        end
        i -= 1;
    end
    deref_stack.delete();

    if deref then
        var type = tt_get_ast_type(tt, ast.u.member_access.expr);
        if type_is_reference(type) then
            type = type_deref_type(type);
            assert(type, "TODO: Type is reference but has no ref type\n");
        end
        assert(type_is_struct(type) or type_is_union(type),
               "TODO: catch this bug in type checker.\n");
        var fields;
        if type_is_struct(type) then
            fields = type_struct_fields(type);
        elif type_is_union(type) then
            fields = type_union_fields(type);
        end
        var i = 0; var len = fields.length;
        var member = ast.u.member_access.member;
        var field: Field&;
        while i < len do
            field = fields.get(i);
            if cstr_eq(field.name, member) then
                break;
            end
            i += 1;
        end
        var size = type_size(field.type);
        assert(size > 0, "Compiler bug: size cannot be zero for auto-deref\n");
        assert(size <= PTR_BITS, "TODO: support larger than memory read: %d\n", size);
        ir_append(self, make_ir_ptr_read(size));
    end
end

def ir_emit_scope_resolve self, ast, st, tt in
    check_ast_kind(AstK::ScopeResolve, ast);
    assert(false, "not implemented\n");
end

def ir_emit_get_reference self, ast, st, tt in
    check_ast_kind(AstK::GetReference, ast);
    var expr = ast.u.get_reference;
    if expr.kind == AstK::MemberAccess then
        ir_emit_member_access(self, expr, st, tt, false);
    elif expr.kind == AstK::Ident then
        var ident = expr.u.ident;
        if ir_is_local(self, ident) then
            var n = ir_get_local(self, ident);
            var offs = ir_get_local_offset(self, ident);
            ir_append(self, make_ir_ref_local(ident, n, offs));
        elif ir_is_global(self, ident) then
            var gi = ir_get_global(self, ident);
            ir_append(self, make_ir_ref_global(ident, gi.label));
        else
            assert(false, "TODO: `%s` is not a local nor global, how to get reference?\n", ident);
        end
    else
        assert(false, "ir_emit_get_reference not implemented for %s\n", ast_kind_cstr(expr.kind));
    end
end

def ir_emit_sizeof_type self, ast, st, tt in
    check_ast_kind(AstK::SizeofType, ast);
    var type = ast.u.sizeof.type;
    ir_append(self, make_ir_push_int(type.size));
end

def ir_emit_static_assert self, ast, st, tt in
    check_ast_kind(AstK::StaticAssert, ast);
end

def ir_emit_offsetof self, ast, st, tt in
    check_ast_kind(AstK::OffsetOf, ast);
    var expr = ast.u.offsetof;
    var bit_offset = _comptime_offsetof(expr, tt, 0);
    ir_append(self, make_ir_push_int(bit_offset / BYTE_BITS));
end

def ir_emit_tuple_literal self, ast, st, tt in
    check_ast_kind(AstK::TupleLiteral, ast);
    // allocate N+1 slots in data section
    var len = ast.u.tuple_literal.args.length;
    var tuple_label = ir_tuple_label(self, len);
    ir_append(self, make_ir_push_int(len));
    ir_append(self, make_ir_push_label(tuple_label));
    ir_append(self, make_ir_ptr_write(INT_BITS));

    if len != 0 then
        var i = 0;
        while i < len do
            ir_compile(self, ast.u.tuple_literal.args.get(i), st, tt);
            ir_append(self, make_ir_push_label(tuple_label));
            ir_append(self, make_ir_ptr_offs((1 + i) * PTR_BITS));
            ir_append(self, make_ir_ptr_write(PTR_BITS));
            i += 1;
        end
    end

    ir_append(self, make_ir_push_label(tuple_label));
end

def ir_emit_tuple_length self, ast, st, tt in
    check_ast_kind(AstK::TupleLength, ast);
    ir_compile(self, ast.u.tuple_length.expr, st, tt);
    ir_append(self, make_ir_ptr_read(INT_BITS));
end

def ir_emit_tuple_get self, ast, st, tt in
    check_ast_kind(AstK::TupleGet, ast);
    ir_compile(self, ast.u.tuple_get.idx, st, tt);
    ir_append(self, make_ir_push_int(1));
    ir_append(self, make_ir_simple_op(IrKind::OpAdd)); // N+1
    ir_append(self, make_ir_push_int(8));
    ir_append(self, make_ir_simple_op(IrKind::OpMul)); // (N+1) * 8
    ir_compile(self, ast.u.tuple_get.expr, st, tt);
    ir_append(self, make_ir_simple_op(IrKind::OpAdd));
    ir_append(self, make_ir_ptr_read(INT_BITS));
end

def ir_emit_cast self, ast, st, tt in
    check_ast_kind(AstK::Cast, ast);
    ir_compile(self, ast.u.cast_.expr, st, tt);
end

def ir_compile self: IrContext&, ast: Ast&, st: SymbolTable&, tt: TypeTable& in
    var k = ast.kind;
    ir_push_src_loc(self, ast.token.src_loc);
    if k == AstK::Ident then ir_emit_ident(self, ast, st, tt);
    elif k == AstK::Integer then ir_emit_integer(self, ast, st, tt);
    elif k == AstK::String then ir_emit_string(self, ast, st, tt);
    elif k == AstK::Call then ir_emit_call(self, ast, st, tt);
    elif k == AstK::BinOp then ir_emit_binop(self, ast, st, tt);
    elif k == AstK::Return then ir_emit_return(self, ast, st, tt);
    elif k == AstK::VarDecl then ir_emit_var_decl(self, ast, st, tt);
    elif k == AstK::VarAssign then ir_emit_var_assign(self, ast, st, tt);
    elif k == AstK::Def then ir_emit_def(self, ast, st, tt);
    elif k == AstK::IfElse then ir_emit_if_else(self, ast, st, tt);
    elif k == AstK::While then ir_emit_while(self, ast, st, tt);
    elif k == AstK::PointerRead then ir_emit_pointer_op(self, ast, st, tt);
    elif k == AstK::PointerWrite then ir_emit_pointer_op(self, ast, st, tt);
    elif k == AstK::Prefix then ir_emit_prefix_op(self, ast, st, tt);
    elif k == AstK::Const then ir_emit_const(self, ast, st, tt);
    elif k == AstK::Extern then ir_emit_extern(self, ast, st, tt);
    elif k == AstK::InlineAsm then ir_emit_inline_asm(self, ast, st, tt);
    elif k == AstK::Global then ir_emit_global(self, ast, st, tt);
    elif k == AstK::Break then ir_emit_break(self, ast, st, tt);
    elif k == AstK::Continue then ir_emit_continue(self, ast, st, tt);
    elif k == AstK::AssignOp then ir_emit_assign_op(self, ast, st, tt);
    elif k == AstK::Struct then ir_emit_struct(self, ast, st, tt);
    elif k == AstK::MemberAccess then ir_emit_member_access(self, ast, st, tt, true);
    elif k == AstK::AssignMember then ir_emit_assign_member(self, ast, st, tt);
    elif k == AstK::Enum then ir_emit_enum(self, ast, st, tt);
    elif k == AstK::ScopeResolve then ir_emit_scope_resolve(self, ast, st, tt);
    elif k == AstK::GetReference then ir_emit_get_reference(self, ast, st, tt);
    elif k == AstK::Union then ir_emit_union(self, ast, st, tt);
    elif k == AstK::SizeofType then ir_emit_sizeof_type(self, ast, st, tt);
    elif k == AstK::StaticAssert then ir_emit_static_assert(self, ast, st, tt);
    elif k == AstK::OffsetOf then ir_emit_offsetof(self, ast, st, tt);
    elif k == AstK::TupleLiteral then ir_emit_tuple_literal(self, ast, st, tt);
    elif k == AstK::TupleLength then ir_emit_tuple_length(self, ast, st, tt);
    elif k == AstK::TupleGet then ir_emit_tuple_get(self, ast, st, tt);
    elif k == AstK::Cast then ir_emit_cast(self, ast, st, tt);
    else
        printf("`ir_compile` in File \"%s\", line %d\n", __FILE__, __LINE__);
        printf("Unhandled AstK: %s (%d)\n", ast_kind_cstr(k), k);
        print_ast_src_loc(ast);
        exit(1);
    end
    ir_pop_src_loc(self);
end

def ir_resolve_lazy_idents self in
    var instrs = self.instructions;
    var i = 0; var len = instrs.length;
    var k; var ir; var token;
    var info = NULL;
    while i < len do
        ir = instrs.get(i);
        k = ir.kind;
        if k == IrKind::LazyIdent then
            token = ir.ident();
            var symbol = ir.symbol();
            var new_ir;
            if ir_is_const(self, symbol.name) then
                var info = ir_get_const(self, symbol.name);
                if info.kind == CIK::String then
                    new_ir = make_ir_push_label(info.value);
                elif info.kind == CIK::Integer then
                    new_ir = make_ir_push_int(info.value);
                end
            elif ir_is_def(self, symbol.name) then
                info = ir_get_def(self, symbol.name);
                new_ir = make_ir_push_label(info.label);
            elif ir_is_extern(self, symbol.name) then
                info = ir_get_extern(self, symbol.name);
                new_ir = make_ir_push_label(info.label);
            elif ir_is_label(self, symbol.name) then
                new_ir = make_ir_push_label(symbol.name);
            else
                printf("ERROR: Undeclared identifier: `%s`\n", symbol.name);
                print_token_loc(token);
                exit(1);
            end
            new_ir.src_loc = token.src_loc;
            instrs.set(i, new_ir);
        elif k == IrKind::CallLazyIdent then
            token = ir.ident();
            var symbol = ir.symbol();
            var nargs = ir.nargs();
            var call = NULL;
            if ir_is_def(self, symbol.name) then
                info = ir_get_def(self, symbol.name);
                call = make_ir_call(info.label, info.varargs);
            elif ir_is_extern(self, symbol.name) then
                info = ir_get_extern(self, symbol.name);
                call = make_ir_call(info.label, info.varargs);
            elif ir_is_label(self, symbol.name) then
                call = make_ir_call(symbol.name, false);
            else
                printf("ERROR: Undeclared identifier: `%s`\n", symbol.name);
                print_token_loc(token);
                exit(1);
            end
            call.src_loc = token.src_loc;
            instrs.set(i, call);
        end
        i += 1;
    end
end

def ir_compile_roots self: IrContext&, roots: Vector[Ast&]&, symbol_table: SymbolTable&, type_table: TypeTable&, compile_order: Vector[Ast&]& in

    if false then
        // compile everything in order
        var i = 0; var len = roots.length;
        while i < len do
            ir_compile(self, roots.get(i), symbol_table, type_table);
            i += 1;
        end
    else
        // or only compile the call/reference graph
        var i = 0; var len = compile_order.length;
        while i < len do
            ir_compile(self, compile_order.get(i), symbol_table, type_table);
            i += 1;
        end
    end

    ir_resolve_lazy_idents(self);
end

def check_ir_kind expect, ir in
    var actual = ir.kind;
    if expect != actual then
        printf("check_ir_kind failed: expected %s, actual was %s\n",
            ir_instr_kind_cstr(expect),
            ir_instr_kind_cstr(actual));
        abort();
    end
end

def ir_print_whole_ir self: IrContext& in
    var instrs = self.instructions;
    var i = 0; var len = instrs.length;
    while i < len do
        print_ir(instrs.get(i));
        i += 1;
    end
end
