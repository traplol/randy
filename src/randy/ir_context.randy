def print_ir_alloc_temps self in
    printf("(IR.AllocTemps ");
    printf("n=%d)\n", self.slot_b);
end
def print_ir_call self in
    printf("(IR.Call ");
    printf("label='%s', ", self.slot_a);
    printf("varargs=%d)\n", self.slot_c);
end
def print_ir_call_lazy_ident self in
    printf("(IR.CallLazyIdent ");
    printf("ident=<Token:%s>, ", cast(self.slot_a, Token&).value);
    printf("nargs=%d)\n", self.slot_b);
end
def print_ir_lazy_ident self in
    printf("(IR.LazyIdent ");
    printf("ident=<Token:%s>)\n", cast(self.slot_a, Token&).value);
end
def print_ir_close_def self in
    printf("(IR.CloseDef ");
    printf("src_name='%s', ", self.slot_c);
    printf("name='%s')\n", self.slot_a);
end
def print_ir_free_temps self in
    printf("(IR.FreeTemps ");
    printf("n=%d)\n", self.slot_b);
end
def print_ir_get_local self in
    printf("(IR.GetLocal ");
    printf("local='%s', ", self.slot_a);
    printf("n=%d, offs=%d)\n", self.slot_b, self.expr_offs);
end
def print_ir_ref_local self in
    printf("(IR.RefLocal ");
    printf("local='%s', ", self.slot_a);
    printf("n=%d, offs=%d)\n", self.slot_b, self.expr_offs);
end
def print_ir_goto self in
    printf("(IR.Goto ");
    printf("label='%s')\n", self.slot_a);
end
def print_ir_goto_false self in
    printf("(IR.GotoFalse ");
    printf("label='%s')\n", self.slot_a);
end
def print_ir_goto_top_false self in
